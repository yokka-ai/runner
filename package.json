{
  "name": "yokka-runner",
  "version": "0.2.0",
  "description": "Starts Claude Code and Codex on your machine for cards on your Yokka board.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yokka-ai/runner.git"
  },
  "homepage": "https://github.com/yokka-ai/runner#readme",
  "bugs": {
    "url": "https://github.com/yokka-ai/runner/issues"
  },
  "keywords": [
    "yokka",
    "claude-code",
    "codex",
    "kanban",
    "agents",
    "runner"
  ],
  "type": "module",
  "bin": {
    "yokka-runner": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "PROTOCOL.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "npm pack --dry-run --json | node scripts/checkPack.ts",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run pack:check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "convex": "^1.46.0",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.4",
    "@vitest/coverage-istanbul": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
